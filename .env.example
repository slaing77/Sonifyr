# Sonifyr Environment Variables

# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Session Secret (generate a random secure string)
SESSION_SECRET=your_secure_random_session_secret_here

# Spotify OAuth (Primary Authentication)
# 
# SETUP INSTRUCTIONS: See README.md "Spotify Developer Setup" section
# 
# 1. Go to: https://developer.spotify.com/dashboard
# 2. Create an app
# 3. Add these Redirect URIs in your Spotify app settings:
#    - http://localhost:5000/api/auth/spotify/callback (for development)
#    - https://your-domain.com/api/auth/spotify/callback (for production)
# 4. Copy Client ID and Client Secret here:
#
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# OpenAI API (for playlist generation)
OPENAI_API_KEY=your_openai_api_key

# Deployment Domain (for OAuth callbacks)
# Format: domain.com or subdomain.domain.com (no protocol)
REPLIT_DOMAINS=your-domain.com

# SendGrid Email Service (optional)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=your_from_email@example.com

# Google Cloud Storage (optional, for file uploads)
# GCS_BUCKET=your_bucket_name
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# ===== DEPRECATED VARIABLES =====
# The following variables are no longer used after Spotify-only OAuth migration:
# - GOOGLE_CLIENT_ID (removed: Google OAuth)
# - GOOGLE_CLIENT_SECRET (removed: Google OAuth)
# - DISCORD_CLIENT_ID (removed: Discord OAuth)
# - DISCORD_CLIENT_SECRET (removed: Discord OAuth)
# - SPOTIFY_SERVICE_REFRESH_TOKEN (removed: service account)
